  "pipelineInfo": {
    "description": "\u65bd\u8a2d\u3054\u3068\u306e\u5fdc\u8afe\u4e88\u6e2c\u306e\u5b66\u7fd2\u30fb\u6607\u683c\u3068\u3001\u624b\u4fee\u6b63\u306e\u304f\u308a\u8fd4\u3057\u306e\u691c\u51fa",
