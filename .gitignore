# Node / フロントエンド（package-lock.json は再現性のため追跡する）
node_modules/
dist/
coverage/
*.log
.env*
.DS_Store
.firebase/

# 手元の検証用スクリプト・スクリーンショット等
test-*.js
manual-*.js
*.png
*.txt
screenshots/
artifacts/

# ドキュメントは *.png / *.txt 除外の例外として追跡する
!docs/
!docs/**

# ピッチ用メディア（開発用リポジトリのみ。LFS）は *.png 除外の例外として追跡する
!media/
!media/**

# Python 依存定義は追跡する（上の *.txt 除外の例外）
!api/requirements*.txt
!solver-api/requirements*.txt

# Python
__pycache__/
.pytest_cache/
.venv/

# Terraform
*.tfstate*
.terraform/
infra/tfplan*

# 合成データの生成物（再生成できる。truth.jsonは検証用の真値なので公開しない）
scripts/synth/out/
